<%layout('layouts/boilerplate')%> <!-- Rendering the layout template 'boilerplate' for the page -->

<div id="cluster-map""></div>
<!-- header -->
<h1>All Campgrounds</h1>
    <div>
        <!-- add new campground link -->
        <a href="/campgrounds/new">Add new campground</a>
    </div>
    <%for(let campground of campgrounds){%>
        <div class="card mb-3" ><!-- 'card' class creates a Bootstrap card component with appropriate styling and spacing. 'mb-3' adds a margin-bottom to the card for spacing between elements. -->
            <div class="row"><!-- 'row' class is used to create a horizontal layout for the child columns, ensuring proper alignment of the card's content. -->
                <!--Image-->
                <div class="col-md-4"><!-- 'col-md-4' creates a responsive column that takes up 4 out of 12 grid columns on medium screens and larger, ensuring the image occupies a third of the card's width. -->
                    <% if (campground.images.length) { %>
                        <img crossorigin="anonymous" class="img-fluid" alt="" src="<%= campground.images[0].url %>">
                    <% } else { %>
                        <img crossorigin="anonymous" class="img-fluid" alt="" src="https://res.cloudinary.com/dry6tmhnt/image/upload/v1739470957/NestCampFire/s2lk1ev57ofqnepf4ho6.jpg">
                    <% } %>
                    </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <!--Title-->
                        <h5 class="card-title"><%=campground.title %></h5>
                        <!--Description-->
                        <p class="card-text"><%=campground.description%></p>
                        <!--Location-->
                        <p class="card-text">
                            <small class="text-muted"><%=campground.location%></small>
                        </p>
                        <!--Button-->
                        <p>
                            <a class="btn btn-primary" href="/campgrounds/<%=campground._id%>">View <%=campground.title%></a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    <%}%>


<script>
    const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';  // Retrieve the MapTiler API key from environment variables and assign it to a JavaScript variable
    const campgrounds = { features: <%- JSON.stringify(campgrounds) %>};// Convert the `campgrounds` data from the server into a JSON object for use in the client-side map
</script>
<script src="/javascripts/clusterMap.js"></script>