<%layout('layouts/boilerplate')%>

<link rel="stylesheet" href="/stylesheets/stars.css">
<div class="row">
    <div class="col-6">
        <div class="card mb-3">
          <!-- Carousel for the images -->
          <div id="campgroundCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
              <%campground.images.forEach((img,i)=>{%>            
                <div class="carousel-item <%=i===0 ? 'active':'' %>">
                  <img crossorigin="anonymous" src="<%=img.url%>" class="card-img-top" alt="...">
                </div>
              <%}) %>
            </div>
            <%if(campground.images.length>1){%>
              <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            <%}%>
          </div>

           
          <div class="card-body">
            <!-- title -->
            <h5 class="card-title"><%=campground.title%></h5>
            <!-- description -->
            <p class="card-text"><%=campground.description %></p>
          </div>
          <ul class="list-group list-group-flush">
            <!-- location -->
            <li class="list-group-item text-muted"><%=campground.location%></li>
            <!-- author -->
            <li class="list-group-item">Submitted by <%=campground.author.username%></li>
            <!-- price -->
            <li class="list-group-item">&#8377;<%=campground.price%>/night</li>
          </ul>
          <!-- if current user is the owner of the campground then show the edit link and delete button -->
          <%if(currentUser && campground.author.equals(currentUser._id)){%>
            <div class="card-body">
                <!-- Edit -->
                <a class="card-link btn btn-info" href="/campgrounds/<%=campground._id%>/edit">Edit</a>
                <!-- Delete -->
                <form class="d-inline" action="/campgrounds/<%=campground._id%>?_method=DELETE" method="POST"> <!--Form to delete the campground with DELETE method using method-override -->
                    <button class="btn btn-danger">DELETE</button>
                </form>
            </div>
          <% }%>
        </div>
    </div>
    <div class="col-6">
      <!-- map -->
      <div id='map'></div>
      <!-- if user is logged in -->
      <%if(currentUser){%>
        <!--Show leave a review option -->
        <h2>Leave a Review</h2>
              <form action="/campgrounds/<%=campground._id%>/reviews" method="POST" class="validated-form mb-3" novalidate>
                <div class="mb-3">
                  <fieldset class="starability-basic">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>
                <div class="mb-3">
                  <label for="body">Review</label>
                  <textarea class="form-control" name="review[body]" id="body" cols="30" rows="3" required></textarea>
                  <div class="valid-feedback">
                    Looks good!
                  </div>
                </div>
                <button class="btn btn-success">Submit</button>
              </form>
            <%} %>
            <!-- show all the reviews -->
            <% for(let review of campground.reviews){ %>
              <div class="card mb-5">
                <div class="card-body">
                  <h5 class="card-title"><%=review.author.username %></h5>
                  <p class="starability-result" data-rating="<%=review.rating%>">
                    Rated : <%=review.rating%> stars
                  </p>            
                  <p class="card-text">Review: <%=review.body%></p>
                  <!-- if user owns the review then show the delete review option -->
                  <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                    <form action="/campgrounds/<%=campground._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                      <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  <%}%>
                </div>
              </div>            
            <%}%>
    </div>
</div>

<script>
  const maptilerApiKey = '<%-process.env.MAPTILER_API_KEY%>';// Retrieve the MapTiler API key from environment variables and store it in a JavaScript variable
  const campground = <%- JSON.stringify(campground) %> ; // Convert the `campground` object from the server into a JSON object for use in the client-side script
</script>

<script src="/javascripts/showPageMap.js"></script>