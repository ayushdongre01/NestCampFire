<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NestCampFire</title>

    <!-- Bootstrap CSS for styling and responsive design -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <!-- CSS for home page -->
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>

<!-- Body with dark theme and centered text -->
<body class="d-flex text-center text-white bg-dark">
    <!-- Main container for page layout -->
    <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
        <!-- Header section -->
        <header class="mb-auto">
            <div>
                <!-- Website title -->
                <h3 class="float-md-left mb-0">NestCampFire</h3>
                <!-- Navigation bar -->
                <nav class="nav nav-masthead justify-content-center float-md-right">
                    <a class="nav-link active" aria-current="page" href="#">Home</a>
                    <a class="nav-link" href="/campgrounds">Campgrounds</a>

                    <!-- Conditional rendering of login/logout links based on user authentication -->
                    <% if(!currentUser) { %>
                    <a class="nav-link" href="/login">Login</a>
                    <a class="nav-link" href="/register">Register</a>
                    <% } else { %>
                    <a class="nav-link" href="/logout">Logout</a>
                    <% } %>
                </nav>
            </div>
        </header>
        <main class="px-3">
            <h1>NestCampFire</h1>
            <!-- <p class="lead"> Welcome to NestCampFire! <br> Jump right in and explore our many campgrounds. <br>
                Feel free to share some of your own and comment on others!</p> -->

            <!-- Welcome message and description -->
            <p class="lead">
                🌲 Welcome to <strong>NestCampFire!</strong> 🔥 <br>
                Discover breathtaking campgrounds and share your adventures! ⛺<br>
                Join our community—explore, comment, and create your own campsites! 🌍
            </p>

            <!-- Button to navigate to campgrounds page -->
            <a href="/campgrounds" class="btn btn-lg btn-secondary font-weight-bold border-white bg-white">View
                Campgrounds</a>
        </main>

        <!-- Footer section -->
        <footer class="mt-auto text-white-50">
            <p>&copy; 2025 </p>
        </footer>


    </div>

    <!-- Bootstrap JS for interactive components -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
    crossorigin="anonymous"></script>
    <!-- Popper.js for handling tooltips and popovers in Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"
    integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p"
    crossorigin="anonymous"></script>
</body>
</html>